

# ElevenLabs: used for BOTH speech-to-text (Scribe realtime) and text-to-speech.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: any ElevenLabs voice ID (default is "Sarah", a premade voice).
ELEVENLABS_VOICE_ID=

# Google Gemini (free tier works): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: override the Gemini model. Leave empty to use Pipecat's default.
# Example: gemini-2.5-flash
GOOGLE_MODEL=

# Optional
CLINIC_TZ=Asia/Kolkata
PORT=7860
# RESET_DB=1   # wipe and re-seed the mock rota on start

# Comma-separated browser origins allowed to call the API (default: local dev ports).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:7860
# Required to call POST /api/reset (wipes all appointments). Leave unset to disable it.
# ADMIN_TOKEN=change-me

# Secret used to hash phone numbers before they touch the database (numbers are never stored).
# If unset, a random key is created in server/.phone_key (git-ignored). KEEP IT: if it's lost,
# returning callers can no longer be matched to their old bookings. Back it up separately from nexov.db.
# PHONE_HASH_KEY=
